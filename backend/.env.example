# Copia este archivo a .env y completa los valores reales para tu entorno.
# NUNCA commitees el archivo .env con valores reales.

# Cadena de conexión PostgreSQL. Obligatoria — el proceso no arranca sin ella.
DATABASE_URL=postgresql://panaderia:panaderia@localhost:5432/panaderia_dev

# Secreto usado para firmar/verificar JWT. Obligatoria — NUNCA tiene un
# default en código. Genera un valor propio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Este placeholder es intencionalmente inválido para uso real:
JWT_SECRET=changeme_do_not_use_in_prod

# Tiempo de expiración del access token (default 8h si se omite).
JWT_EXPIRES_IN=8h

# Puerto HTTP del servidor Fastify (default 3000 si se omite).
PORT=3000

# development | staging | production. Obligatoria.
NODE_ENV=development

# Lista blanca de orígenes CORS (dominio del frontend web). Obligatoria.
CORS_ORIGIN=http://localhost:5173

# URL pública base de este backend (sin slash final), usada para construir
# URLs absolutas hacia archivos estáticos (p.ej. imageUrl de recetas/
# ingredientes en public/images/, ver src/db/seed.ts). Opcional — si se
# omite, se arma como http://localhost:<PORT>.
PUBLIC_BASE_URL=http://localhost:3000

# Umbral (%) de margen real por debajo del cual un producto se marca como
# "poco rentable" en el reporte de rentabilidad (RF-012, SDD-07 CU6). Opcional
# — si se omite, se usa 20 (mismo valor de ejemplo usado en SDD-07 CU6).
LOW_MARGIN_THRESHOLD_PERCENT=20

# Cotización del dólar (GET /api/exchange-rate, público). Oficial BCB fija;
# paralelo = Binance P2P (API no oficial) cacheado EXCHANGE_RATE_TTL_MINUTES.
OFFICIAL_USD_BUY=6.86
OFFICIAL_USD_SELL=6.96
EXCHANGE_RATE_TTL_MINUTES=10

# Contraseñas para el script de seed (ver src/db/seed.ts). Opcionales:
# si se omiten, el script genera contraseñas aleatorias y las imprime
# una sola vez por consola (nunca se hardcodean en el código fuente).
SEED_ADMIN_PASSWORD=
SEED_OPERARIO_PASSWORD=
SEED_DUENO_PASSWORD=
